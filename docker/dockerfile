FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

ENV TZ=Europe/Vienna
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install required Ubuntu packages
RUN apt-get update --fix-missing && \
    apt-get install -y software-properties-common && \
    add-apt-repository universe && \
    apt-get update && \
    apt-get install -y \
      libgtk2.0-dev \
      wget bzip2 ca-certificates curl git vim tmux \
      g++ gcc build-essential cmake checkinstall gfortran \
      libjpeg8-dev libtiff5-dev pkg-config yasm \
      libavcodec-dev libavformat-dev libswscale-dev \
      libxine2-dev libv4l-dev qtbase5-dev libtbb-dev \
      libatlas-base-dev libfaac-dev libmp3lame-dev libtheora-dev \
      libvorbis-dev libxvidcore-dev libopencore-amrnb-dev \
      libopencore-amrwb-dev x264 v4l-utils libprotobuf-dev \
      protobuf-compiler libgoogle-glog-dev libgflags-dev \
      libgphoto2-dev libhdf5-dev doxygen libflann-dev \
      libboost-all-dev proj-data libproj-dev libyaml-cpp-dev \
      cmake-curses-gui libdc1394-dev

# Install additional libraries
RUN apt-get install -y libzmq3-dev freeglut3-dev

# Install Python and development tools
RUN apt-get update && apt-get install -y python3-pip python3-dev

# Install OpenCV via pip (note: these wheels are built without CUDA)
RUN pip3 install opencv-python opencv-contrib-python

# Installing additional Python packages
RUN pip3 install torch==2.1.1+cu118 torchvision==0.16.1+cu118 torchaudio==2.1.1 --extra-index-url https://download.pytorch.org/whl/cu118 && \
    pip3 install "git+https://github.com/facebookresearch/pytorch3d.git@stable" && \
    pip3 install trimesh joblib scikit-learn pyyaml transformations warp-lang imageio tqdm open3d ruamel.yaml kornia pyrender scipy

ENV CUDA_HOME /usr/local/cuda
ENV LD_LIBRARY_PATH /usr/local/cuda/lib64

ENV OPENCV_IO_ENABLE_OPENEXR=1

# Install more Python packages as needed
RUN pip3 install scikit-image meshcat webdataset omegaconf pypng roma seaborn openpyxl wandb imgaug Ninja xlsxwriter timm albumentations xatlas rtree nodejs jupyterlab objaverse g4f ultralytics==8.0.120 pycocotools videoio numba 
RUN pip3 install h5py

# Install extra utilities
RUN apt-get update --fix-missing && \
    apt-get install -y rsync lbzip2 pigz zip p7zip-full p7zip-rar

RUN apt-get install -y libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-xinerama0 
RUN apt-get install -y libxcb-xkb-dev libxkbcommon-x11-0 libxcb-cursor-dev

RUN pip3 install casadi
RUN pip3 install "git+https://github.com/openai/CLIP.git"
RUN pip3 install ttach kornia validators transformers tensorboardX
RUN pip3 install --no-cache-dir causal-conv1d mamba-ssm timm==0.9.0 einops
RUN pip3 install nltk triton
RUN pip3 install sentencepiece
# If it has a problem with libcudart.0 
# RUN pip3 install --upgrade torch
